direction: right

title: "How an LLM Works"
title.style.font-size: 28
title.style.bold: true

subtitle: "A simplified overview of tokenization → embedding → transformer → output"
subtitle.style.font-size: 14
subtitle.style.font-color: "#64748b"
subtitle.style.italic: true

# Pipeline stages — simple horizontal flow
INPUT: {
  shape: rectangle
  style.fill: "#e0f2fe"
  style.stroke: "#0ea5e9"
  style.stroke-width: 2
  style.font-color: "#0369a1"
  style.font-size: 12
  style.bold: true

  raw: {
    shape: rectangle
    style.fill: "#ffffff"
    style.stroke: "#94a3b8"
    style.font-size: 16
    style.font-color: "#1e293b"
    label: "\"The cat sat\""
  }
}

TOKENIZE: {
  shape: rectangle
  style.fill: "#fef3c7"
  style.stroke: "#f59e0b"
  style.stroke-width: 2
  style.font-color: "#b45309"
  style.font-size: 12
  style.bold: true

  tokens: {
    style.fill: "#ffffff"
    style.stroke: "#d97706"
    style.font-size: 12
    style.font-color: "#1e293b"
    label: "the · cat · sat · eos"
  }

  ids: {
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
    label: "IDs [464, 1712, 3290, 2]"
  }
}

EMBED: {
  shape: rectangle
  style.fill: "#dcfce7"
  style.stroke: "#22c55e"
  style.stroke-width: 2
  style.font-color: "#15803d"
  style.font-size: 12
  style.bold: true

  vec: {
    style.fill: "#ffffff"
    style.stroke: "#16a34a"
    style.font-size: 11
    style.font-color: "#166534"
    label: "[0.2, -0.1, 0.8, ...]\n× 4 tokens"
  }

  dim: {
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
    label: "4 × 4096"
  }
}

TRANSFORMER: {
  shape: rectangle
  style.fill: "#f3e8ff"
  style.stroke: "#a855f7"
  style.stroke-width: 2
  style.font-color: "#7e22ce"
  style.font-size: 12
  style.bold: true

  ln: {
    style.fill: "#ffffff"
    style.stroke: "#c084fc"
    style.font-size: 10
    style.font-color: "#581c87"
    label: "Layer Norm"
  }

  attn: {
    style.fill: "#ffffff"
    style.stroke: "#c084fc"
    style.font-size: 10
    style.font-color: "#581c87"
    label: "Self-Attention\nQ × K^T × V"
  }

  ffn: {
    style.fill: "#ffffff"
    style.stroke: "#c084fc"
    style.font-size: 10
    style.font-color: "#581c87"
    label: "Feed-Forward\nGLU + SwiGLU"
  }

  more: {
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
    label: "× N layers"
  }
}

OUTPUT: {
  shape: rectangle
  style.fill: "#ffe4e6"
  style.stroke: "#f43f5e"
  style.stroke-width: 2
  style.font-color: "#be123c"
  style.font-size: 12
  style.bold: true

  logits: {
    style.fill: "#ffffff"
    style.stroke: "#e11d48"
    style.font-size: 11
    style.font-color: "#9f1239"
    label: "logits (vocab size)"
  }

  prob: {
    style.fill: "#fef08a"
    style.stroke: "#eab308"
    style.font-size: 11
    style.font-color: "#854d0e"
    label: "softmax → probabilities"
  }

  sample: {
    style.font-size: 11
    style.font-color: "#64748b"
    style.italic: true
    label: "Sample next token"
  }
}

GENERATED: {
  shape: rectangle
  style.fill: "#f0fdf4"
  style.stroke: "#22c55e"
  style.stroke-width: 2
  style.font-color: "#15803d"
  style.font-size: 18
  style.italic: true
  label: "\" on the mat\""
}

INPUT -> TOKENIZE
TOKENIZE -> EMBED
EMBED -> TRANSFORMER
TRANSFORMER -> OUTPUT
OUTPUT -> GENERATED

# Bottom explanatory text — not connected to GENERATED
explanatory: {
  shape: text
  style.font-size: 13
  style.font-color: "#475569"
  label: "Each token attends to all previous tokens via scaled dot-product attention"
}

formula_text: {
  shape: text
  style.font-size: 16
  style.font-color: "#1e293b"
  style.bold: true
  label: "Attention(Q, K, V) = softmax(QK^T / √d_k) × V"
}

model_note: {
  shape: text
  style.font-size: 12
  style.font-color: "#64748b"
  style.italic: true
  label: "The model learns Q, K, V projection matrices during training to attend to relevant context"
}

training_note: {
  shape: text
  style.font-size: 12
  style.font-color: "#64748b"
  style.italic: true
  label: "Training: predict next token from previous tokens. Inference: autoregressive generation."
}
