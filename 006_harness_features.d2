vars: {
	d2-config: {
		layout-engine: elk
	}
}

direction: right

title: Advanced Features of Coding Harnesses {
  shape: text
  near: top-center
  style: {
    font-size: 55
    bold: true
  }
}

overview: "Overview of Coding Harness Types" {
  open_multi: |md
  	# Open Source Multi-Provider
	 	- Open Source
	  - multiple LLM providers
		## Examples
		- [Pi Coding Agent](https://pi.dev)
		- [OpenCode](https://opencode.ai)
  |
  open_provider: |md
  	# Open Source Single-Provider
	 	- Open Source
		- tied to single LLM Provider
		## Examples
		- [Codex](https://github.com/openai/codex)
  |
  closed_provider: |md
  	# Closed Source Single-Provider
	 	- Proprietary
		- tied to single LLM Provider
		## Examples
		- [Claude Code](https://www.anthropic.com/claude)
		- [Gemini](https://ai.google.dev)
  |
  closed_multi: |md
  	# Closed Source Multi-Provider
	 	- Closed Source
		- multiple LLM providers
		## Examples
		- [Github Copilot](https://github.com/features/copilot)
		- [Factory (Droid)](https://factory.ai)
		- [Amp](https://ampcode.com)
  |
}

tools: "Tools and Model Context Protocol (MCP)" {
	tool: Tool
	mcp: MCP
	harness: Coding Harness
	tool -> harness: builtin
  mcp -> harness: server-client architecture
}

skills: "Skills" {
	skill: SKILL.md {
		md: |md
			# Using Maven (mvn)
			When compiling Maven projects, use this command:
			```bash
			./mvnw -T2.0 compile
		|
		metadata: |yaml
			description: Use when launching maven (mvn) commands
		|
	}
	tool: "Skill loading tool"
	context: "System Prompt"
	agent: "Coding Agent"

	agent -> context -> skill.metadata
	agent -> tool -> skill.md
}

commands: "Commands" {
	command: COMMAND.md {
		md: |md
			Be extra careful, double check results and use TDD.
		|
		metadata: |yaml
			name: careful
		|
	}
	context: "System Prompt"
	agent: "Coding Agent"
	human: "Human"
	human -> agent: /careful
	agent -> context -> command.md
}

multiagent: "Multiple Agents" {
	bob: bob.md {
		md: |md
			Your name is Bob.
		|
		metadata: |yaml
			name: bob
		|
	}
	alice: alice.md {
		md: |md
			Your name is Alice.
		|
		metadata: |yaml
			name: alice
		|
	}
	context: "System Prompt"
	harness: "Coding Harness"
	human: "Human"

	human -> harness: /select-agent bob
	harness -> context -> bob.md

	human -> harness: /select-agent alice
	harness -> context -> alice.md
}

subagent: "Subagents and Delegation" {
	main_agent: "Main Agent"
	sub_agent: "Sub Agent"
	delegate: "Delegate tool"
	main_agent -> delegate
	delegate -> sub_agent: Spawn subagent with FRESH context
}

acp: "Agent Client Protocol" {
	ide: "IDE"
	harness: "Coding Harness"

	ide <-> harness: server-client architecture
}
